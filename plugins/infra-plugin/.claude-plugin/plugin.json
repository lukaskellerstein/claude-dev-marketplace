{
  "name": "infra-plugin",
  "version": "1.0.0",
  "description": "Infrastructure toolkit for Google Cloud, Kubernetes, Docker, Terraform, and Helm deployments",
  "author": {
    "name": "Lukas Kellerstein",
    "email": "lukas@example.com"
  },
  "license": "MIT",
  "keywords": [
    "infrastructure",
    "kubernetes",
    "k8s",
    "docker",
    "terraform",
    "helm",
    "gcp",
    "google-cloud",
    "containers",
    "orchestration",
    "iac",
    "devops",
    "cloud",
    "deployment"
  ],
  "mcpServers": {
    "gcloud": {
      "command": "npx",
      "args": ["-y", "@google-cloud/gcloud-mcp"]
    },
    "terraform": {
      "command": "docker",
      "args": ["run", "-i", "--rm", "hashicorp/terraform-mcp-server:0.2.3"]
    }
  }
}
